{
  "expo": {
    "name": "Knight-Daddy",
    "slug": "knight-daddy",
    "version": "1.0.0",
    "scheme": "knightdaddy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f1e6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brubru6707.knightdaddy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f1e6",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f5f1e6"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
