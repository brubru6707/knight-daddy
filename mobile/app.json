{
  "expo": {
    "name": "Knight-Daddy",
    "slug": "knight-daddy",
    "version": "1.0.0",
    "scheme": "knightdaddy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f1e6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brubru6707.knightdaddy",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Knight-Daddy turns your spoken question into text so it can answer from the stock's headlines.",
        "NSMicrophoneUsageDescription": "Knight-Daddy listens only while you hold Talk, to hear your question about a stock's news."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f1e6",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brubru6707.knightdaddy",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f5f1e6"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Knight-Daddy listens only while you hold Talk, to hear your question about a stock's news."
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Knight-Daddy listens only while you hold Talk, to hear your question about a stock's news.",
          "speechRecognitionPermission": "Knight-Daddy turns your spoken question into text so it can answer from the stock's headlines."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de4da73e-8fa5-4437-8071-b4470381c7b8"
      }
    },
    "owner": "brubru6707"
  }
}
