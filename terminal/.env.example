# Copy to .env and fill in. Never commit .env.
# Where the classifier runs. Leave empty to use the local GPU (Oscar).
# Set to the Modal URL (from `modal deploy backend/modal_app.py`) to use Modal instead.
MODEL_ENDPOINT_URL=
MODEL_ENDPOINT_TOKEN=
# Paths (defaults shown)
POC_DIR=~/poc1
ADAPTER_DIR=~/poc1/adapters/qwen35-2b
CACHE_DIR=~/scratch/poc1/terminal
BACKTEST_CACHE=~/scratch/poc1/backtest
PORT=8000
# Live news (Finnhub company news; falls back to Yahoo if empty or failing)
FINNHUB_API_KEY=
# AI briefing (Gemini) and read-aloud (ElevenLabs)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5
